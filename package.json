{
    "name": "newtab",
    "version": "0.1.0",
    "private": true,
    "description": "Command palette, shortcuts, Pomodoro, study heatmap and word of the day for Firefox's new tab.",
    "type": "module",
    "license": "GPL-3.0",
    "scripts": {
        "dev": "vite build --watch",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint:ext": "web-ext lint --source-dir dist",
        "start": "web-ext run --source-dir dist",
        "pack": "web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
        "source-archive": "git archive --format=zip --prefix=devtab/ -o artifacts/DevTab-source.zip HEAD",
        "sign:unlisted": "node tools/sign.mjs unlisted",
        "sign:listed": "node tools/sign.mjs listed"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/outfit": "^5.3.0",
        "preact": "^10.29.8"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.6",
        "@testing-library/preact": "^3.2.4",
        "@types/firefox-webext-browser": "^143.0.0",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^29.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "web-ext": "^10.6.0"
    }
}
